# Copy this file to .env and fill in your keys. Never commit .env.

# Main model: Gemini (key from https://aistudio.google.com/apikey).
# Copy the exact model IDs from AI Studio. Tried in order, left to right.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest

# Fallbacks: OpenRouter free models that support tool calling
# (list: https://openrouter.ai/models?supported_parameters=tools&max_price=0).
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,inclusionai/ling-3.2-flash:free

# Seconds to wait for one model before trying the next.
LLM_TIMEOUT=7

# The clinic's "now" (YYYY-MM-DD HH:MM). Default is Monday morning.
CLINIC_NOW=2026-12-07 08:00

# Optional: where the SQLite file lives (default data/clinic.db).
# CLINIC_DB=data/clinic.db

# Optional bonus: copy each booking to a Google Calendar. Leave empty to switch it off.
# GOOGLE_CALENDAR_ID is under the calendar's Settings > Integrate calendar.
# The key file is a service-account JSON key; keep it in the secrets/ folder (never committed).
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-calendar.json
